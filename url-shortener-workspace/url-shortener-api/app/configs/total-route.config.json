[
    {
        "route": "/api/v1/auth/register",
        "method": "post",
        "action": "register",
        "controller": "auth",
        "middleware": []
    },
    {
        "method": "POST",
        "route": "/api/v1/auth/login",
        "controller": "auth",
        "action": "login",
        "middlewareNameList": ["validateJsonContentType"]
    },
    {
        "method": "POST",
        "route": "/api/v1/urls",
        "controller": "url",
        "action": "createUrl",
        "middlewareNameList": ["validateJsonContentType", "authenticate", "authorizeUser"]
    },
    {
        "method": "PUT",
        "route": "/api/v1/users/me/photo",
        "controller": "user",
        "action": "updateAvatar",
        "middlewareNameList": ["authenticate", "uploadAvatar"]
    },
    {
        "method": "GET",
        "route": "/api/v1/admin/users",
        "controller": "admin",
        "action": "listUsers",
        "middlewareNameList": ["authenticate", "authorizeAdmin", "validatePaginationQuery"]
    }
]
